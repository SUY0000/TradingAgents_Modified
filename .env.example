# LLM Providers (set the one you use)
OPENAI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
DASHSCOPE_CN_API_KEY=
ZHIPU_API_KEY=
ZHIPU_CN_API_KEY=
MINIMAX_API_KEY=
MINIMAX_CN_API_KEY=
OPENROUTER_API_KEY=

# Optional: point at a remote Ollama server. When unset, defaults to
# the local instance at http://localhost:11434/v1. Convention follows
# the broader Ollama ecosystem; both the CLI dropdown and programmatic
# client pick this up.
#OLLAMA_BASE_URL=http://your-ollama-host:11434/v1

# Optional: override DEFAULT_CONFIG without editing code.
# Any TRADINGAGENTS_* variable below, when set, replaces the matching key
# in tradingagents/default_config.py. Values are coerced to the type of
# the existing default (bool / int / str), so "true"/"3" work as expected.
#TRADINGAGENTS_LLM_PROVIDER=openai
#TRADINGAGENTS_DEEP_THINK_LLM=gpt-5.4
#TRADINGAGENTS_QUICK_THINK_LLM=gpt-5.4-mini
#TRADINGAGENTS_LLM_BACKEND_URL=
#TRADINGAGENTS_OUTPUT_LANGUAGE=English
#TRADINGAGENTS_MAX_DEBATE_ROUNDS=1
#TRADINGAGENTS_MAX_RISK_ROUNDS=1
#TRADINGAGENTS_CHECKPOINT_ENABLED=false

CUSTOM_OPENAI_BASE_URL=
CUSTOM_OPENAI_API_KEY=
# Optional: extra HTTP headers sent on every request to the custom OpenAI-compatible
# endpoint. Format is a JSON object string. Use for fingerprint/identity headers such
# as User-Agent or X-Title. Do NOT put Authorization here — that comes from API_KEY.
# Example: CUSTOM_OPENAI_HEADERS='{"User-Agent": "my-bot/1.0 (external, cli)"}'
CUSTOM_OPENAI_HEADERS=

CUSTOM_ANTHROPIC_BASE_URL=
CUSTOM_ANTHROPIC_API_KEY=
# Same as above, but for the custom Anthropic-compatible endpoint.
CUSTOM_ANTHROPIC_HEADERS=

# Optional: DeepSeek reasoning effort and thinking mode overrides.
# deepseek_reasoning_effort: "high" | "max" (DeepSeek default when unset)
# deepseek_thinking_enabled: "true"/"false" — explicitly enable/disable chain-of-thought.
#   Leave unset to rely on the model's own default (V4 models default to enabled).
#TRADINGAGENTS_DEEPSEEK_REASONING_EFFORT=high
#TRADINGAGENTS_DEEPSEEK_THINKING_ENABLED=true

# Crypto data sources (used when asset_type = crypto)
# CoinGecko Demo — token fundamentals and sentiment votes.
#   Optional; omitting it uses the unauthenticated public endpoint
#   (30 req/min, 10 000 req/month). Add a key to raise the limit.
#   Register: https://www.coingecko.com/en/api  → "Get Demo API Key"
COINGECKO_DEMO_API_KEY=

# DefiLlama, Alternative.me Fear & Greed, and OKX public endpoints
# do not require any API key — leave them unset.
